# Modify this file and put it at "mtgjson5/resources/mtgjson.properties"

[CardHoarder]
token=

[CardMarket]
app_token=
app_secret=
mkm_access_token=
mkm_access_token_secret=

[EDHRec]
api_url=
# Where the weekly edhrecRank snapshot is archived so fresh containers reuse it.
# Without a bucket, ranks come straight from Scryfall every build (daily churn).
rank_snapshot_bucket_name=
rank_snapshot_object_path=
# Days a snapshot is reused before ranks are refreshed (default 7).
rank_refresh_days=

[GitHub]
api_token=

[MTGBan]
api_key=

[MTGJSON]
version=
date=
use_cache=
# Previous BuildManifest.json (path or URL), used to carry each file's
# content_changed_on forward when its content_sha256 hasn't changed.
previous_manifest=

[Prices]
bucket_name=
bucket_object_path=

[Pushover]
app_token=
user_tokens=

[Scryfall]
name=
client_id=
client_secret=

[TCGPlayer]
app_id=
client_id=
client_secret=
api_version=
# Where each good build archives its product catalog, so a build whose fetch
# fails can restore it instead of publishing an empty TcgplayerSkus.json.
# Without a bucket the fallback is the last published TcgplayerSkus.json, which
# carries no product names and so costs that build its alt-foil identifiers.
catalog_bucket_name=
catalog_object_path=